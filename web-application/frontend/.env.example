######################
# Configuration file #
######################

# Port for development mode
DEV_PORT=8080

# Platform name
VITE__PLATFORM_NAME=Nubemsystems

# Platform description
VITE__PLATFORM_DESCRIPTION=Nubemsystems Platform

# Default language
VITE__I18N_LOCALE=en

# API server URL (development)
VITE__DEV_TEST_HOST=http://localhost

# API server URL (production)
VITE__API_SERVER_HOST=/

# Parent domain for SSO UI cookies shared with Keycloak (e.g. .example.com).
# Leave empty for auto-detect on production hosts; localhost uses host-only cookies.
#VITE__COOKIE_DOMAIN=.example.com


### Captcha service ###

#VITE__CAPTCHA_SERVICE=reCAPTCHA
#VITE__RECAPTCHA_SITE_KEY=
