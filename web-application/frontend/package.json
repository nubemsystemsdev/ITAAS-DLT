{
    "name": "frontend",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "serve": "vite",
        "dev": "vite",
        "start": "vite",
        "build": "vite build",
        "lint": "prettier --write . && cross-env ESLINT_USE_FLAT_CONFIG=true eslint --fix .",
        "prettier": "prettier --write .",
        "test": "node --test test/*.test.mjs && vue-tsc --noEmit && cross-env ESLINT_USE_FLAT_CONFIG=true eslint . && prettier --check .",
        "update-locales": "npm run update-translations",
        "update-translations": "node scripts/translate-file-maker.cjs",
        "apply-missing-translations": "node scripts/apply-missing-translations.cjs"
    },
    "dependencies": {
        "@asanrom/request-browser": "1.0.5",
        "check-password-strength": "2.0.7",
        "decimal.js": "10.4.3",
        "echarts": "6.1.0",
        "qrcode.vue": "3.3.3",
        "sanitize-html": "2.18.1",
        "three": "^0.150.0",
        "vue": "3.5.44",
        "vue-echarts": "8.0.1",
        "vue-recaptcha-v3": "2.0.1",
        "vue-router": "4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "8.57.1",
        "@types/sanitize-html": "2.6.2",
        "@vitejs/plugin-vue": "6.0.6",
        "@vue/tsconfig": "0.4.0",
        "cross-env": "^10.1.0",
        "dotenv": "16.3.1",
        "eslint": "8.57.1",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-vue": "10.11.1",
        "globals": "15.14.0",
        "prettier": "3.0.0",
        "typescript": "5.2.2",
        "typescript-eslint": "8.72.0",
        "vite": "7.3.7",
        "vue-tsc": "2.0.29"
    },
    "engines": {
        "node": ">=24.22.1 <25"
    }
}
