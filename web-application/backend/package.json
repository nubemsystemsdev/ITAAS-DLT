{
  "name": "backend",
  "version": "0.0.1",
  "description": "Backend Server",
  "main": "index.js",
  "scripts": {
    "watch": "npm run watch:ts",
    "watch:ts": "npm run build:ts -- --watch --diagnostics",
    "prebuild": "npm run lint",
    "compile": "tsc --pretty",
    "build": "npm run server-build",
    "server-build": "rimraf dist && tsc --pretty",
    "lint": "eslint --fix src/**/*.ts",
    "setup-mongo": "node dist/setup-mongo.js",
    "update-locales": "npm run update-translations",
    "update-translations": "node scripts/translate-file-maker.js",
    "update-db-scripts": "node scripts/gen-db-scripts.js",
    "reset-blockchain-sync": "node dist/reset-blockchain-sync.js",
    "update-api-bindings": "node scripts/gen-api-bindings.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "start": "node dist/index.js",
    "unit-tests": "mocha --bail --exit --recursive --timeout 60000 -r ts-node/register \"test/mocha/function-tests/*.ts\"",
    "api-tests": "mocha --bail --exit --recursive --timeout 60000 -r ts-node/register \"test/mocha/api-tests/*.ts\"",
    "test": "npm run unit-tests && npm run api-tests"
  },
  "dependencies": {
    "@asanrom/async-tools": "1.1.1",
    "@asanrom/express-swagger-generator": "2.1.5",
    "@asanrom/javascript-object-sanitizer": "1.0.0",
    "@cyberchain/smart-contract-wrapper": "2.0.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "decimal.js": "10.4.3",
    "did-jwt": "^8.0.18",
    "did-jwt-vc": "^4.0.16",
    "did-resolver": "^4.1.0",
    "dotenv": "16.3.1",
    "ethereum-cryptography": "2.1.2",
    "ethers": "^6.13.5",
    "ethr-did": "^3.0.38",
    "ethr-did-resolver": "^11.0.4",
    "express": "4.22.1",
    "express-async-errors": "3.1.1",
    "express-fileupload": "1.4.0",
    "express-useragent": "1.0.15",
    "ffprobe": "1.1.2",
    "form-data": "4.0.6",
    "i18n": "0.15.1",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "lru-cache": "10.0.1",
    "mime-types": "2.1.35",
    "nodemailer": "10.1.7",
    "rimraf": "5.0.1",
    "speakeasy": "2.0.0",
    "stripe": "^20.3.1",
    "tsbean-driver-mongo": "3.0.3",
    "tsbean-driver-mysql": "2.0.6",
    "tsbean-driver-postgres": "2.0.2",
    "tsbean-orm": "2.0.2",
    "winston": "3.11.0",
    "winston-elasticsearch": "0.19.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@asanrom/request-axios": "1.0.10",
    "@types/chai": "4.3.6",
    "@types/cookie-parser": "1.4.4",
    "@types/express": "4.17.17",
    "@types/express-fileupload": "1.4.1",
    "@types/express-useragent": "1.0.2",
    "@types/express-ws": "3.0.1",
    "@types/ffprobe": "1.1.8",
    "@types/i18n": "0.13.6",
    "@types/ioredis": "4.28.10",
    "@types/jsonwebtoken": "9.0.2",
    "@types/mime-types": "2.1.4",
    "@types/mocha": "10.0.10",
    "@types/node": "20.6.0",
    "@types/rimraf": "3.0.2",
    "@types/speakeasy": "2.0.7",
    "@types/ws": "8.5.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "chai": "4.3.8",
    "eslint": "8.57.1",
    "ignore": "5.2.4",
    "mocha": "12.0.3",
    "ts-node": "10.9.1",
    "typescript": "5.2.2"
  },
  "overrides": {
    "axios": "1.20.0",
    "elastic-apm-node": "4.18.0",
    "js-yaml": "5.5.0",
    "lodash": "4.18.1",
    "mysql2": "3.24.6",
    "qs": "6.16.1",
    "semver": "7.8.5",
    "uuid": "11.1.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "author": "",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "peerDependencies": {
    "typescript": "5.2.2"
  },
  "private": true,
  "license": "ISC"
}
