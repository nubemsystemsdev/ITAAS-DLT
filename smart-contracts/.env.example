###################################
# Deployment script configuration #
###################################

# Protocol: http, https, ws or wss
BLOCKCHAIN_NODE_PROTOCOL=http

# URL to connect to the node
BLOCKCHAIN_NODE_RPC_URL=http://localhost:8547

## Cyberchain Admin Keys for Contract Deployment

# Admin key type: ec or ml-dsa
# ec: ECDSA key (primary key)
# ml-dsa: ML-DSA key (post-quantum)
BLOCKCHAIN_PK_ADMIN_TYPE=ec

# ECDSA Admin Private Key (hex, without 0x prefix)
# For the local chain, copy ec.key from cyberchain-test-node/test-admin-wallet.
BLOCKCHAIN_PK_ADMIN_EC=

# ML-DSA Admin Private Key (hex, without 0x prefix) - Only for Cyberchain
# REQUIRED for mixed-mode: copy ml_dsa.sec from cyberchain-test-node/test-admin-wallet
BLOCKCHAIN_PK_ADMIN_ML=
# ML-DSA Admin Public Key (hex, without 0x prefix) - Only for Cyberchain
# REQUIRED: copy ml_dsa.pub from cyberchain-test-node/test-admin-wallet
BLOCKCHAIN_PK_ADMIN_ML_PUB=

# ML-DSA security level: 44, 65, or 87 (higher = more secure but larger keys)
ML_DSA_LEVEL=44

# Log debug messages? (YES/NO)
LOG_DEBUG=NO

###################################
# Test configuration              #
###################################

# Protocol: http, https, ws or wss
TEST_BLOCKCHAIN_NODE_PROTOCOL=http

# URL to connect to the node
TEST_BLOCKCHAIN_NODE_RPC_URL=http://localhost:8547

# Admin key type: ec or ml-dsa
TEST_BLOCKCHAIN_PK_ADMIN_TYPE=ec

# ECDSA Admin Private Key (hex, without 0x prefix)
# Same authorized wallet as BLOCKCHAIN_PK_ADMIN_EC above
TEST_BLOCKCHAIN_PK_ADMIN_EC=

# ML-DSA Admin Private Key (hex, without 0x prefix)
# Copy ml_dsa.sec / ml_dsa.pub from cyberchain-test-node/test-admin-wallet
TEST_BLOCKCHAIN_PK_ADMIN_ML=
# ML-DSA Admin Public Key (hex, without 0x prefix)
TEST_BLOCKCHAIN_PK_ADMIN_ML_PUB=

# ML-DSA security level: 44, 65, or 87
TEST_ML_DSA_LEVEL=44
